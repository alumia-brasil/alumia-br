texto nome = leia("Seu nome: ")
inteiro idade = para_inteiro(leia("Sua idade: "))
escreval("Olá, " + maiusculas(nome) + "!")

booleano adulto = idade >= 18 e nao falso
se (adulto) {
    escreval("Você é maior de idade.")
} senao {
    escreval("Você é menor de idade.")
}

lista<decimal> notas = [7, 8.5, 10]
notas[0] = para_decimal(leia("Primeira nota: "))
decimal total = 0
para (inteiro i = 0; i < tamanho(notas); i = i + 1) {
    total = total + notas[i]
}
decimal media = total / tamanho(notas)
escreval("Média: ", media)
escreval("Média arredondada: ", arredondar(media))

inteiro contador = 1
enquanto (contador <= 3) {
    escreva(contador, " ")
    contador = contador + 1
}
escreval()
escreval("Raiz de 9: ", raiz(9))
escreval("2 elevado a 3: ", potencia(2, 3))
escreval("Número aleatório: ", aleatorio())
